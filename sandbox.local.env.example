# Copy to sandbox.local.env and fill in credentials locally.
API_BASE=http://35.220.164.252:3888/v1
API_KEY=
SUMMARY_MODEL_NAME=

# Sandbox and tool routing for this harness copy.
SCIENCE_AGENT_TOOLS=search,visit,python,google_scholar
SCIENCE_AGENT_READ_PAGE_MODE=file
AGENT_ANSWER_TYPE=boxed
PYTHON_TOOL_RETURN_MAX_CHARS=6000
# QUOTA_EXCEEDED during creation automatically tries ailab-ma4agismall.
SCIENCE_AGENT_SANDBOX_RESOURCE=10.12.111.143/ailab-ai4sgi
SCIENCE_AGENT_SANDBOX_IMAGE=registry.h.pjlab.org.cn/ailab-ai4sgi-ailab_ai4sgi_pool/yqy:science-agent-cpu-20261010
PYTHON_SESSION_BACKEND=gateway_sandbox
SCIENCE_AGENT_TOOL_HTTP_BACKEND=gateway_sandbox
SCIENCE_AGENT_SANDBOX_HTTP_STRICT=true
SCIENCE_AGENT_SANDBOX_NETWORK_DEFAULT_ACTION=allow
# Verified inside each instance before updating its resolver.
SCIENCE_AGENT_SANDBOX_DNS_SERVERS=1.1.1.1,8.8.8.8
SCIENCE_AGENT_SANDBOX_CA_BUNDLE=auto

# Judge uses this API and the existing API_KEY by default.
SCIENCE_AGENT_JUDGE_BASE_URL=http://35.220.164.252:3888/v1
SCIENCE_AGENT_JUDGE_MODEL=o3-mini

# Optional ordered Judge services. Leave unset to use the legacy primary + direct fallback.
# SCIENCE_AGENT_JUDGE_CONFIG=/absolute/path/to/judge_services.json

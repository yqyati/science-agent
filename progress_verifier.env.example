# New *_progress agent entry only. Original agent entries ignore this feature.
SCIENCE_AGENT_PROGRESS_VERIFIER=0
# Independent OpenAI-compatible verifier endpoint; no policy/judge key fallback.
PROGRESS_VERIFIER_BASE_URL=
PROGRESS_VERIFIER_MODEL=
PROGRESS_VERIFIER_API_KEY=EMPTY
PROGRESS_VERIFIER_TIMEOUT=90
PROGRESS_VERIFIER_MAX_OUTPUT_TOKENS=2048
PROGRESS_VERIFIER_EXTRA_BODY='{}'
PROGRESS_VERIFIER_MAX_CHECKPOINTS=8
PROGRESS_VERIFIER_CONCURRENCY=2
PROGRESS_VERIFIER_MAX_INPUT_BYTES=2000000
PROGRESS_VERIFIER_LOG_DIR=log/progress_verifier
